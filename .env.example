# Copy this file to `.env` and edit. NEVER commit the real `.env`.

# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# true for local development, false in production
DJANGO_DEBUG=true

# Comma separated host names the server may answer to
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma separated origins of the React app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DJANGO_TIME_ZONE=Asia/Kolkata

# JWT lifetimes
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=1

# Login brute-force protection
LOGIN_THROTTLE_RATE=10/min
# Per IP address (generous, so a whole lab behind one IP is not blocked)
LOGIN_IP_THROTTLE_RATE=300/min
# Number of reverse proxies in front of Django (e.g. 1 for nginx); leave unset for none
# DRF_NUM_PROXIES=1
# true when nginx/load balancer terminates HTTPS and sends X-Forwarded-Proto
# DJANGO_BEHIND_PROXY=false
# Teachers may add a lecture at most this many days in the past
ATTENDANCE_BACKDATE_DAYS=30

# Only used when DJANGO_DEBUG=false (behind HTTPS)
# DJANGO_SSL_REDIRECT=true
# DJANGO_HSTS_SECONDS=31536000

# Low-attendance alert: percentage limit, rolling window in days, minimum marked lectures
LOW_ATTENDANCE_THRESHOLD=75
LOW_ATTENDANCE_DAYS=30
LOW_ATTENDANCE_MIN_LECTURES=3

# Staff attendance: a check-in after this local time (HH:MM) is recorded as Late
STAFF_LATE_AFTER=10:00

# Encrypted backups: python manage.py backup_db  (key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# BACKUP_ENCRYPTION_KEY=
# BACKUP_DIR=backups
# Where error and security logs are written (default: backend/logs)
# LOG_DIR=logs

# Notes shared with students: where uploaded files are kept, and the size limit in MB
# UPLOAD_DIR=uploads
# NOTE_MAX_MB=10
# Requests per minute per IP for the public student link page
# PUBLIC_THROTTLE_RATE=1500/min   (per IP; a whole class on the college Wi-Fi shares one IP)

# Printed at the top of PDF reports (the web pages use frontend/src/config.js)
# COLLEGE_NAME=Modern College of Arts, Science & Commerce
# COLLEGE_ADDRESS=Ganeshkhind Road, Pune

# Where request counters (login / public-page limits) are kept, shared by all workers. Must be writable by the service user.
# CACHE_DIR=cache

# Database. Default is the SQLite file db.sqlite3. For PostgreSQL set:
# DB_ENGINE=postgres
# DB_NAME=attendance
# DB_USER=attendance
# DB_PASSWORD=change-me
# DB_HOST=localhost
# DB_PORT=5432

# Optional: only these networks may call /api/ (comma separated, CIDR). Leave empty to allow all
# (login is still required). Example: the college network.
# API_ALLOWED_NETWORKS=103.20.1.0/24
